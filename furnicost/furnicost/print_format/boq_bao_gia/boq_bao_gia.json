 "font_size": 0,
 "html": "<style>\n  @page {\n    size: 297mm 210mm;\n    margin: 10mm;\n  }\n  .print-format {\n    font-family: \"Times New Roman\", serif;\n    font-size: 10pt;\n    color: #000;\n    width: 100%;\n    \n    \n  }\n  .title {\n    text-align: center;\n    font-size: 16pt;\n    font-weight: bold;\n    margin: 8mm 0 4mm;\n  }\n  .subline {\n    text-align: center;\n    margin-bottom: 6mm;\n  }\n  .info-table {\n    width: 100%;\n    margin-bottom: 4mm;\n  }\n  .info-table td {\n    padding: 2px 4px;\n    vertical-align: top;\n  }\n  .boq-table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n  }\n  .boq-table th,\n  .boq-table td {\n    border: 1px solid #000;\n    padding: 4px;\n    word-wrap: break-word;\n  }\n  .boq-table td {\n    vertical-align: top;\n  }\n  .boq-table th {\n    text-align: center;\n    font-weight: bold;\n    vertical-align: middle;\n    padding: 12px 6px;\n  }\n  .boq-table td.num {\n    text-align: right;\n    white-space: nowrap;\n  }\n  .totals {\n    width: 100%;\n    margin-top: 4mm;\n  }\n  .totals td {\n    padding: 2px 4px;\n  }\n  .totals .label {\n    text-align: right;\n    font-weight: bold;\n    width: 85%;\n    text-transform: uppercase;\n    font-size: 11pt;\n  }\n  .totals .num {\n    font-size: 11pt;\n  }\n  .notes {\n    margin-top: 6mm;\n    border: 1px solid #000;\n    padding: 6px;\n    min-height: 24mm;\n  }\n  .signatures {\n    width: 100%;\n    margin-top: 12mm;\n  }\n  .signatures td {\n    text-align: center;\n    padding-top: 12mm;\n    font-weight: bold;\n  }\n  .image-cell img {\n    max-width: 200px;\n    max-height: 200px;\n  }\n  .letter-head {\n    text-align: center;\n  }\n  .letter-head table {\n    margin: 0 auto;\n  }\n  .letter-head img {\n    display: block;\n    margin: 0 auto;\n  }\n  .totals,\n  .totals td {\n    border: none !important;\n  }\n</style>\n\n{% if letter_head %}\n  {{ letter_head }}\n{% endif %}\n\n<div class=\"title\">B\u1ea2NG B\u00c1O GI\u00c1</div>\n{% set d = frappe.utils.getdate(doc.transaction_date) %}\n<div class=\"subline\">Ng\u00e0y {{ d.day }} th\u00e1ng {{ d.month }} n\u0103m {{ d.year }}</div>\n\n<table class=\"info-table\">\n  <tr>\n    <td><strong>Kh\u00e1ch h\u00e0ng:</strong> {{ doc.customer_name or \"\" }}</td>\n  </tr>\n  <tr>\n    <td><strong>\u0110\u1ecba ch\u1ec9:</strong> {{ doc.get(\"address_display\") or \"\" }}</td>\n  </tr>\n  <tr>\n    <td><strong>D\u1ef1 \u00e1n:</strong> {{ doc.get(\"project\") or \"\" }}</td>\n    \n  </tr>\n</table>\n\n<div style=\"margin-bottom: 4mm;\">\n  C\u00f4ng ty ch\u00fang t\u00f4i xin tr\u00e2n tr\u1ecdng g\u1eedi \u0111\u1ebfn qu\u00fd kh\u00e1ch h\u00e0ng b\u1ea3ng b\u00e1o gi\u00e1 v\u1edbi chi ti\u1ebft nh\u01b0 sau:\n</div>\n\n<table class=\"boq-table\">\n  <colgroup>\n    <col style=\"width: 4%\">\n    <col style=\"width: 8%\">\n    <col style=\"width: 14%\">\n    <col style=\"width: 6%\">\n    <col style=\"width: 6%\">\n    <col style=\"width: 6%\">\n    <col style=\"width: 5%\">\n    <col style=\"width: 5%\">\n    <col style=\"width: 6%\">\n    <col style=\"width: 9%\">\n    <col style=\"width: 9%\">\n    <col style=\"width: 8%\">\n    <col style=\"width: 14%\">\n    <col style=\"width: 6%\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th>STT</th>\n      <th>H\u1ea1ng m\u1ee5c</th>\n      <th>M\u00f4 t\u1ea3 v\u1eadt li\u1ec7u</th>\n      <th>D\u00e0i (mm)</th>\n      <th>Cao (mm)</th>\n      <th>S\u00e2u (mm)</th>\n      <th>S\u1ed1 l\u01b0\u1ee3ng</th>\n      <th>\u0110\u01a1n v\u1ecb</th>\n      <th>Kh\u1ed1i l\u01b0\u1ee3ng</th>\n      <th>\u0110\u01a1n gi\u00e1</th>\n      <th>Th\u00e0nh ti\u1ec1n</th>\n      <th>S\u1ea3n xu\u1ea5t/Xu\u1ea5t x\u1ee9</th>\n      <th>\u1ea2nh minh h\u1ecda</th>\n      <th>Ghi ch\u00fa</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for row in doc.items %}\n    <tr>\n      <td class=\"num\">{{ loop.index }}</td>\n      <td>{{ row.item_name or \"\" }}</td>\n      <td>{{ row.material_description or \"\" }}</td>\n      <td class=\"num\">{{ frappe.format(row.length, {\"fieldtype\":\"Float\",\"precision\":0}) }}</td>\n      <td class=\"num\">{{ frappe.format(row.height, {\"fieldtype\":\"Float\",\"precision\":0}) }}</td>\n      <td class=\"num\">{{ frappe.format(row.depth, {\"fieldtype\":\"Float\",\"precision\":0}) }}</td>\n      <td class=\"num\">{{ row.qty or 0 }}</td>\n      <td>{{ row.uom or \"\" }}</td>\n      <td class=\"num\">{{ row.weight_rc or 0 }}</td>\n      <td class=\"num\">{{ frappe.format(row.rate, {\"fieldtype\":\"Float\",\"precision\":0}) }}</td>\n      <td class=\"num\">{{ frappe.format(row.amount, {\"fieldtype\":\"Float\",\"precision\":0}) }}</td>\n      <td>{{ row.origin or \"\" }}</td>\n      <td class=\"image-cell\">{% if row.image %}<img src=\"{{ row.image }}\">{% endif %}</td>\n      <td>{{ row.notes or \"\" }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<table class=\"totals\">\n  <tr>\n    <td class=\"label\">C\u1ed8NG:</td>\n    <td class=\"num\">{{ doc.get_formatted(\"total\") }}</td>\n  </tr>\n  <tr>\n    <td class=\"label\">THU\u1ebe VAT:</td>\n    <td class=\"num\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\n  </tr>\n  <tr>\n    <td class=\"label\">CHI\u1ebeT KH\u1ea4U:</td>\n    <td class=\"num\">\n      {% if doc.additional_discount_percentage %}\n        {{ doc.additional_discount_percentage }}%\n      {% elif doc.discount_amount %}\n        {{ doc.get_formatted(\"discount_amount\") }}\n      {% else %}\n        0\n      {% endif %}\n    </td>\n  </tr>\n  <tr>\n    <td class=\"label\">T\u1ed4NG C\u1ed8NG:</td>\n    <td class=\"num\"><strong>{{ doc.get_formatted(\"grand_total\") }}</strong></td>\n  </tr>\n</table>\n\n<div class=\"notes\">\n  <strong>Ghi ch\u00fa:</strong><br>\n  {{ doc.remarks or \"\" }}\n</div>\n\n<table class=\"signatures\">\n  <tr>\n    <td>\u0110\u1ea0I DI\u1ec6N B\u00caN A</td>\n    <td>\u0110\u1ea0I DI\u1ec6N B\u00caN B</td>\n  </tr>\n</table>\n",
